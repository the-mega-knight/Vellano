<div class="hk-cart-drawer" id="hk-cart-drawer">
  <div class="hk-cart-overlay" onclick="closeCart()"></div>
  <div class="hk-cart-panel">
    <div class="hk-cart-header">
      <h2>Your Cart</h2>
      <button onclick="closeCart()" class="hk-close-btn">&times;</button>
    </div>
    <div class="hk-progress-bar-container" id="hk-shipping-bar">
      <p id="hk-shipping-msg">Add <span id="hk-shipping-gap">$50.00</span> for FREE Shipping!</p>
      <div class="hk-progress-bar"><div class="hk-progress-fill" id="hk-progress-fill" style="width: 0%"></div></div>
    </div>
    <div class="hk-cart-items">
      <!-- Ajax items injected here -->
      <p class="hk-empty-cart">Your cart is empty. Time to discover balance.</p>
    </div>
    <div class="hk-cart-footer">
      <button class="hk-checkout-btn" onclick="window.location.href='/checkout'">CHECKOUT &mdash; <span id="cart-total">$0.00</span></button>
    </div>
  </div>
</div>

<style>
  .hk-cart-drawer { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 99999; display: none; }
  .hk-cart-drawer.open { display: block; }
  .hk-cart-overlay { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.5); }
  .hk-cart-panel { position: absolute; right: 0; top: 0; width: 400px; max-width: 100vw; height: 100%; background: #F8F6F3; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s ease; }
  .hk-cart-drawer.open .hk-cart-panel { transform: translateX(0); }
  .hk-cart-header { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid #D9D4CE; }
  .hk-cart-header h2 { font-family: var(--font-heading-family); font-size: 24px; color: #111111; margin: 0; }
  .hk-close-btn { background: none; border: none; font-size: 28px; cursor: pointer; color: #111111; }
  .hk-progress-bar-container { padding: 20px; background: #D9D4CE; text-align: center; }
  .hk-progress-bar-container p { font-family: 'Jost', sans-serif; font-size: 13px; color: #111111; margin: 0 0 10px 0; font-weight: 500; }
  .hk-progress-bar { width: 100%; height: 6px; background: #B6B0AA; border-radius: 3px; overflow: hidden; }
  .hk-progress-fill { height: 100%; background: #B8A07A; }
  .hk-cart-items { flex: 1; padding: 20px; overflow-y: auto; font-family: 'Jost', sans-serif; }
  .hk-empty-cart { text-align: center; color: #B6B0AA; margin-top: 50px; }
  .hk-cart-footer { padding: 20px; border-top: 1px solid #D9D4CE; background: #fff; }
  .hk-checkout-btn { width: 100%; background: #111111; color: #F8F6F3; border: none; padding: 16px; font-family: 'Jost', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; border-radius: 4px; transition: background 0.3s; }
  .hk-checkout-btn:hover { background: #333; }
</style>


<script>
  function openCart() {
    document.getElementById('hk-cart-drawer').classList.add('open');
    updateCartDrawer();
  }
  function closeCart() {
    document.getElementById('hk-cart-drawer').classList.remove('open');
  }
  function updateCartDrawer() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        document.getElementById('cart-total').innerText = '$' + (cart.total_price / 100).toFixed(2);

        // Dynamic free-shipping progress bar (threshold: $50)
        const threshold = 5000; // cents
        const total = cart.total_price;
        const pct = Math.min(100, Math.round((total / threshold) * 100));
        const fill = document.getElementById('hk-progress-fill');
        const msg = document.getElementById('hk-shipping-msg');
        const gap = document.getElementById('hk-shipping-gap');
        if (fill) fill.style.width = pct + '%';
        if (total >= threshold) {
          if (msg) msg.innerHTML = "🎉 You've unlocked <strong>FREE Shipping!</strong>";
        } else {
          const remaining = ((threshold - total) / 100).toFixed(2);
          if (gap) gap.innerText = '$' + remaining;
        }

        let itemsHtml = '';
        if(cart.items.length === 0) {
          itemsHtml = '<p class="hk-empty-cart">Your cart is empty. Time to discover balance.</p>';
        } else {
          cart.items.forEach(item => {
            itemsHtml += `
              <div style="display:flex; gap:15px; margin-bottom:20px; padding-bottom:20px; border-bottom:1px solid #eee;">
                <img src="${item.image}" style="width:80px; height:80px; object-fit:cover; border-radius:8px;">
                <div style="flex:1;">
                  <div style="font-family:var(--font-heading-family); font-size:16px; margin-bottom:5px;">${item.product_title}</div>
                  <div style="color:#777; font-size:12px; margin-bottom:10px;">$${(item.price/100).toFixed(2)}</div>
                  <div style="display:flex; align-items:center; gap:10px;">
                     <button onclick="changeCartItem('${item.variant_id}', ${item.quantity - 1})" style="border:1px solid #ccc; background:none; padding:2px 8px; cursor:pointer; border-radius:4px;">-</button>
                     <span style="font-size:13px;">${item.quantity}</span>
                     <button onclick="changeCartItem('${item.variant_id}', ${item.quantity + 1})" style="border:1px solid #ccc; background:none; padding:2px 8px; cursor:pointer; border-radius:4px;">+</button>
                  </div>
                </div>
              </div>
            `;
          });
        }
        document.querySelector('.hk-cart-items').innerHTML = itemsHtml;
      });
  }
  function changeCartItem(variantId, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: quantity })
    }).then(() => updateCartDrawer());
  }
</script>

{% schema %}
{
  "name": "Vellano Cart Drawer"
}
{% endschema %}
