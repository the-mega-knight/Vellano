{%- style -%}
  .vellano-shop { padding: 80px 5%; background: #F8F6F3; font-family: 'Jost', sans-serif; }
  .vellano-shop-header { text-align: center; margin-bottom: 40px; }
  .vellano-shop-eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #B8A07A; margin-bottom: 14px; font-weight: 500; }
  .vellano-shop-title { font-family: var(--font-heading-family); font-size: 42px; font-weight: 400; color: #111; margin-bottom: 10px; }

  /* Responsive Grid/Carousel */
  .vellano-shop-carousel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
    margin: 0 auto;
    padding-bottom: 40px;
  }
  .vellano-shop-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .vellano-shop-card:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  
  @media (max-width: 1000px) {
    .vellano-shop-carousel {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .vellano-shop-title {
      font-size: 32px;
    }
  }
  @media (max-width: 600px) {
    .vellano-shop-card-name { font-size: 15px; }
    .vellano-shop-card-price { font-size: 14px; }
    .vellano-shop-card-add { padding: 8px 12px; font-size: 10px; }
  }

  .vellano-shop-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.08); }
  
  .vellano-shop-card-img-wrap { 
    position: relative; 
    overflow: hidden; 
    aspect-ratio: 1/1;
    background: #F0EDE9;
  }
  .vellano-shop-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .vellano-shop-card:hover .vellano-shop-card-img { transform: scale(1.04); }
  
  .vellano-shop-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #111;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 20px;
    z-index: 2;
  }
  .vellano-shop-card-badge.gold { background: #B8A07A; }
  
  .vellano-shop-card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .vellano-shop-card-cat { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #B8A07A; margin-bottom: 6px; font-weight: 500; }
  .vellano-shop-card-name { font-family: var(--font-heading-family); font-size: 18px; color: #111; margin-bottom: 8px; font-weight: 400; line-height: 1.25; }
  .vellano-shop-card-desc { font-size: 12px; color: #888; line-height: 1.5; margin-bottom: 20px; flex-grow: 1; }
  .vellano-shop-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
  .vellano-shop-card-price { font-size: 16px; font-weight: 600; color: #111; }
  
  .vellano-shop-card-add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #111;
    color: #fff;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .vellano-shop-card-add:hover { background: #333; transform: scale(1.02); }
  .vellano-shop-card-add:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
  .vellano-shop-card-add svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; }
  
{%- endstyle -%}

<div class="vellano-shop">
  <div class="vellano-shop-header">
    <div class="vellano-shop-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="vellano-shop-title">{{ section.settings.title }}</h2>
  </div>

  <div class="vellano-shop-carousel">
    {% for block in section.blocks %}
      {%- assign product = block.settings.product -%}
      {% if product != blank %}
        <a href="{{ product.url }}" class="vellano-shop-card" {{ block.shopify_attributes }}>
          <div class="vellano-shop-card-img-wrap">
            {% if block.settings.badge_text != blank %}
              <div class="vellano-shop-card-badge {% if block.settings.badge_color == 'gold' %}gold{% endif %}">{{ block.settings.badge_text }}</div>
            {% endif %}
            
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: class: 'vellano-shop-card-img', loading: 'lazy' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'vellano-shop-card-img' }}
            {% endif %}
          </div>
          <div class="vellano-shop-card-body">
            <div class="vellano-shop-card-name">{{ product.title }}</div>
            <div class="vellano-shop-card-desc">{{ block.settings.subtitle | default: product.metafields.custom.subtitle | default: 'Enhance your daily routine.' }}</div>
            <div class="vellano-shop-card-footer">
              <div class="vellano-shop-card-price">{{ product.price | money }}</div>
              <form method="post" action="/cart/add" class="vellano-ajax-cart-form" onsubmit="vellanoAddToCart(event, this)">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="vellano-shop-card-add">
                  <span>Add</span> <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                </button>
              </form>
            </div>
          </div>
        </a>
      {% else %}
        <!-- Mock Card (when product isn't selected) -->
        <a href="#" class="vellano-shop-card" {{ block.shopify_attributes }}>
          <div class="vellano-shop-card-img-wrap">
             {{ 'product-1' | placeholder_svg_tag: 'vellano-shop-card-img' }}
          </div>
          <div class="vellano-shop-card-body">
            <div class="vellano-shop-card-name">Product Title</div>
            <div class="vellano-shop-card-desc">Your custom product description will appear here.</div>
            <div class="vellano-shop-card-footer">
              <div class="vellano-shop-card-price">$0.00</div>
              <button class="vellano-shop-card-add">
                Add <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              </button>
            </div>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bestsellers Carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Shop The System"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bestsellers"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Custom Subtitle",
          "info": "Overrides the default subtitle."
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "info": "e.g. 'Award Winning' or 'Save 15%'"
        },
        {
          "type": "select",
          "id": "badge_color",
          "label": "Badge Color",
          "options": [
            { "value": "black", "label": "Black" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "black"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Carousel",
      "category": "Custom",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}