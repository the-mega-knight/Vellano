<style>
  .vellano-compare-section {
    background-color: #faf9f5;
    padding: 80px 20px;
    }
  .vellano-compare-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .vellano-compare-table {
    width: 100%;
    border-collapse: collapse;
  }
  .vellano-compare-th, .vellano-compare-td {
    padding: 20px;
    text-align: center;
    border-bottom: 1px solid #eaeaea;
    font-size: 13px;
    color: #888;
  }
  .vellano-compare-th {
    border-bottom: none;
    padding-bottom: 30px;
    color: #111111;
    font-weight: 600;
  }
  .vellano-compare-th img {
    height: 40px;
    margin-bottom: 10px;
    opacity: 0.5;
  }
  .vellano-row-header {
    text-align: left;
    font-weight: 400;
    color: #555;
    width: 30%;
  }
  .vellano-section-header {
    text-align: left;
    font-size: 16px;
    font-weight: 600;
    color: #111111;
    padding-top: 40px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eaeaea;
  }
  
  .v-check {
    color: #5bb37b;
    font-weight: bold;
    background: #eef8f1;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }
  .v-cross {
    color: #ccc;
    font-weight: bold;
    background: #f5f5f5;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
  }
</style>

<div class="vellano-compare-section">
  <div class="vellano-compare-container">
    <table class="vellano-compare-table">
      <thead>
        <tr>
          <th class="vellano-compare-th vellano-row-header"></th>
          <th class="vellano-compare-th">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.3; margin-bottom:8px;"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><br>
            Aura Smart Body Scale
          </th>
          <th class="vellano-compare-th">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.3; margin-bottom:8px;"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><br>
            MorphoScan Nova
          </th>
          <th class="vellano-compare-th">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.3; margin-bottom:8px;"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><br>
            Aura Basic Scale
          </th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="4" class="vellano-section-header">Key Features</td></tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Display Type</td>
          <td class="vellano-compare-td">3.5" full-color TFT</td>
          <td class="vellano-compare-td">4.3" full-color TFT</td>
          <td class="vellano-compare-td">LED display</td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Retractable handle</td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Segmental fat & muscle analysis</td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Voice guide for accessibility</td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
        </tr>

        <tr><td colspan="4" class="vellano-section-header">Body Metrics</td></tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Total Metrics</td>
          <td class="vellano-compare-td">18 advanced metrics</td>
          <td class="vellano-compare-td">50+ comprehensive</td>
          <td class="vellano-compare-td">13 essential metrics</td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Weight, BMI, BMR</td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Fat & visceral fat</td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
        </tr>
        <tr>
          <td class="vellano-compare-td vellano-row-header">Skeletal Muscle Index</td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
          <td class="vellano-compare-td"><span class="v-check">✓</span></td>
          <td class="vellano-compare-td"><span class="v-cross">✕</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Vellano Compare Table",
  "presets": [{"name":"Vellano Compare Table"}]
}
{% endschema %}
