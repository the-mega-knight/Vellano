{%- style -%}
  .vellano-popup-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(5px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  .vellano-popup-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }
  .vellano-popup-box {
    background: #e6e6e6; /* Soft light grey */
    width: 90%;
    max-width: 400px;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
    padding-bottom: 30px;
  }
  .vellano-popup-overlay.is-active .vellano-popup-box {
    transform: translateY(0);
  }
  .vellano-popup-close {
    position: absolute;
    top: 15px; left: 15px;
    background: rgba(0,0,0,0.5);
    color: #fff;
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    z-index: 10;
  }
  .vellano-popup-img {
    width: 100%;
    height: 250px;
    background: #d4d4d4;
    object-fit: cover;
  }
  .vellano-popup-text {
    font-size: 18px;
    color: #fff;
    margin: 25px 0;
  }
  .vellano-popup-btn {
    display: inline-block;
    background: #F8F6F3;
    color: #fff;
    padding: 12px 30px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border: none;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="vellano-popup-overlay" id="vellanoPopup">
  <div class="vellano-popup-box">
    <button class="vellano-popup-close" onclick="document.getElementById('vellanoPopup').classList.remove('is-active')">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 600 }}" class="vellano-popup-img" alt="{{ section.settings.image.alt | escape }}">
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'vellano-popup-img' }}
    {% endif %}
    <div class="vellano-popup-text">
      {{ section.settings.text | default: 'Get 15% off the Vellano Starter Kit' }}
    </div>
    <button class="vellano-popup-btn" onclick="document.getElementById('vellanoPopup').classList.remove('is-active')">
      {{ section.settings.button_text | default: 'Unlock' }}
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
      if (!sessionStorage.getItem('vellano_popup_seen')) {
        const popup = document.getElementById('vellanoPopup');
        if (popup) {
          popup.classList.add('is-active');
          sessionStorage.setItem('vellano_popup_seen', 'true');
        }
      }
    }, 3000);
  });
</script>

{% schema %}
{
  "name": "Vellano Popup (HK)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "text", "label": "Text", "default": "Unlock an extra 15% off" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Unlock" }
  ],
  "presets": [
    { "name": "Vellano Popup (HK)" }
  ]
}
{% endschema %}
