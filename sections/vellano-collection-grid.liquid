{%- style -%}
  .vellano-collection { padding: 80px 5%; background: #111; color: #fff; font-family: 'Jost', 'Montserrat', sans-serif; }
  .vellano-collection-header { text-align: center; margin-bottom: 50px; }
  .vellano-collection-title { font-family: var(--font-heading-family); font-size: 48px; font-weight: 400; color: #fff; margin-bottom: 10px; }
  .vellano-collection-desc { font-size: 16px; color: #aaa; max-width: 600px; margin: 0 auto; }
  
  .vellano-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
    margin: 0 auto;
  }
  @media (max-width: 1000px) {
    .vellano-collection-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (max-width: 600px) {
    .vellano-collection-grid { grid-template-columns: 1fr; }
  }

  /* Card styling (dark) */
  .vellano-col-card {
    background: #1a1a1a;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    border: 1px solid #333;
  }
  .vellano-col-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
  .vellano-col-card-img-wrap { aspect-ratio: 1/1; overflow: hidden; background: #222; }
  .vellano-col-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .vellano-col-card:hover .vellano-col-card-img { transform: scale(1.04); }
  
  .vellano-col-card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .vellano-col-card-title { font-family: var(--font-heading-family); font-size: 18px; margin-bottom: 8px; color: #fff; line-height: 1.3; }
  .vellano-col-card-price { font-size: 16px; font-weight: 600; color: #B8A07A; margin-top: auto; }
  
  .vellano-collection-apps { margin-top: 40px; }
{%- endstyle -%}

<div class="vellano-collection">
  <div class="vellano-collection-header">
    <h1 class="vellano-collection-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="vellano-collection-desc">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% paginate collection.products by 16 %}
    <div class="vellano-collection-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="vellano-col-card">
          <div class="vellano-col-card-img-wrap">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: class: 'vellano-col-card-img', loading: 'lazy' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'vellano-col-card-img' }}
            {% endif %}
          </div>
          <div class="vellano-col-card-body">
            <div class="vellano-col-card-title">{{ product.title }}</div>
            <div class="vellano-col-card-price">{{ product.price | money }}</div>
          </div>
        </a>
      {% else %}
        <div style="grid-column: 1 / -1; text-align: center; color: #888;">
          <p>No products found in this collection.</p>
        </div>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <div style="margin-top: 40px; text-align: center;">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}

  <!-- App Blocks Support for OS 2.0 -->
  {% if section.blocks.size > 0 %}
    <div class="vellano-collection-apps">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
