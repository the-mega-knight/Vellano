{%- style -%}
  /* =====================================================
     VELLANO HEADER — Full Klean-inspired redesign
     ===================================================== */

  .vellano-hdr {
    background: #F8F6F3;
    border-bottom: 1px solid #E8E4DF;
    position: relative;
    width: 100%;
    z-index: 998;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  .vellano-hdr-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 5%;
    height: 68px;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* LEFT: nav links */
  .vellano-hdr-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1;
  }
  .vellano-hdr-nav > a,
  .vellano-hdr-nav > .vellano-hdr-dropdown-wrap > a {
    color: #111;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-weight: 500;
    transition: color 0.25s;
    white-space: nowrap;
  }
  .vellano-hdr-nav > a:hover,
  .vellano-hdr-nav > .vellano-hdr-dropdown-wrap > a:hover { color: #B8A07A; }

  /* Dropdown nav item */
  .vellano-hdr-dropdown-wrap {
    position: static;
    display: flex;
    align-items: center;
    height: 68px;
  }
  .vellano-hdr-dropdown-wrap > a { display: flex; align-items: center; gap: 4px; }
  .vellano-hdr-dropdown-wrap > a svg { transition: transform 0.2s; }
  .vellano-hdr-dropdown-wrap:hover > a svg { transform: rotate(180deg); }

  /* =====================================================
     MEGA MENU
     ===================================================== */
  .vellano-mega {
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    background: #F8F6F3;
    border-bottom: 1px solid #E8E4DF;
    box-shadow: 0 20px 60px rgba(0,0,0,0.07);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 997;
    pointer-events: none;
  }
  .vellano-mega.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: all;
  }
  .vellano-mega-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 340px;
  }

  /* Left: category tabs */
  .vellano-mega-cats {
    border-right: 1px solid #E8E4DF;
    padding: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .vellano-mega-cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
    color: #888;
    text-decoration: none;
    cursor: pointer;
    border-left: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .vellano-mega-cat:hover,
  .vellano-mega-cat.active {
    color: #111;
    border-left-color: #B8A07A;
    background: rgba(184,160,122,0.05);
  }
  .vellano-mega-cat svg { opacity: 0.4; transition: opacity 0.2s; }
  .vellano-mega-cat:hover svg,
  .vellano-mega-cat.active svg { opacity: 1; }

  /* Right: product panels */
  .vellano-mega-panels {
    padding: 32px 40px;
    position: relative;
  }
  .vellano-mega-panel {
    position: absolute;
    inset: 32px 40px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(10px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-content: start;
  }
  .vellano-mega-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }
  .vellano-mega-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: #111;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: border-color 0.2s, background 0.2s;
  }
  .vellano-mega-card:hover {
    border-color: #E8E4DF;
    background: #fff;
  }
  .vellano-mega-card-img {
    width: 100%;
    height: 140px;
    object-fit: contain;
    object-position: center;
    border-radius: 8px;
    background: #EDEAE5;
    display: block;
    padding: 8px;
    box-sizing: border-box;
  }
  .vellano-mega-card-img-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    background: #EDEAE5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vellano-mega-card-img-placeholder svg { opacity: 0.2; width: 40px; height: 40px; }
  .vellano-mega-card-name {
    font-size: 13px;
    font-weight: 500;
    color: #111;
    line-height: 1.3;
  }
  .vellano-mega-card-price {
    font-size: 12px;
    color: #B8A07A;
    letter-spacing: 0.5px;
  }
  .vellano-mega-showall {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
    color: #888;
    text-decoration: none;
    margin-top: 8px;
    transition: color 0.2s;
  }
  .vellano-mega-showall:hover { color: #111; }

  /* CENTER: logo */
  .vellano-hdr-logo {
    grid-column: 2;
    font-family: var(--font-heading-family);
    font-size: 22px;
    letter-spacing: 5px;
    font-weight: 400;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
    text-align: center;
  }
  .vellano-hdr-logo img {
    width: 200px;
    height: auto;
    display: block;
    margin: 0 auto;
    transform: translateY(-5px);
  }
  @media (max-width: 768px) {
    .vellano-hdr-logo img {
      width: 140px;
    }
  }

  /* RIGHT: actions */
  .vellano-hdr-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-end;
  }
  .vellano-hdr-btn-quiz {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border: 1.5px solid #111;
    border-radius: 30px;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-weight: 500;
    color: #111;
    text-decoration: none;
    transition: background 0.25s, color 0.25s;
    white-space: nowrap;
  }
  .vellano-hdr-btn-quiz:hover { background: #111; color: #F8F6F3; }
  .vellano-hdr-btn-shop {
    display: inline-flex;
    align-items: center;
    padding: 9px 20px;
    background: #111;
    border: 1.5px solid #111;
    border-radius: 30px;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-weight: 500;
    color: #F8F6F3;
    text-decoration: none;
    transition: background 0.25s;
    white-space: nowrap;
  }
  .vellano-hdr-btn-shop:hover { background: #333; border-color: #333; }
  .vellano-hdr-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: #111;
    display: flex;
    align-items: center;
    padding: 6px;
    transition: color 0.25s;
    text-decoration: none;
  }
  .vellano-hdr-icon:hover { color: #B8A07A; }
  .vellano-hdr-icon svg { width: 20px; height: 20px; display: block; }

  /* Language selector */
  .vellano-hdr-lang {
    position: relative;
  }
  .vellano-hdr-lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #777;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 6px 0;
    transition: color 0.25s;
  }
  .vellano-hdr-lang-btn:hover { color: #111; }
  .vellano-hdr-lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #F8F6F3;
    border: 1px solid #E8E4DF;
    border-radius: 12px;
    padding: 10px 0;
    min-width: 140px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .vellano-hdr-lang:hover .vellano-hdr-lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .vellano-hdr-lang-dropdown a {
    display: block;
    padding: 9px 18px;
    font-size: 12px;
    color: #555;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .vellano-hdr-lang-dropdown a:hover { color: #111; }

  /* =====================================================
     SEARCH DRAWER
     ===================================================== */
  .vellano-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .vellano-search-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .vellano-search-drawer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: #F8F6F3;
    padding: 28px 5%;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-100%);
    transition: transform 0.3s ease;
  }
  .vellano-search-overlay.open .vellano-search-drawer {
    transform: translateY(0);
  }
  .vellano-search-input {
    flex: 1;
    background: none;
    border: none;
    border-bottom: 1.5px solid #111;
    padding: 8px 4px;
    font-family: var(--font-heading-family);
    font-size: 22px;
    color: #111;
    outline: none;
    letter-spacing: 1px;
  }
  .vellano-search-input::placeholder { color: #ccc; }
  .vellano-search-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #111;
    font-size: 24px;
    line-height: 1;
  }

  /* =====================================================
     MOBILE HAMBURGER + FULL-SCREEN MENU
     ===================================================== */
  .vellano-hdr-burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 12px; /* Expanded for 44px touch target */
    margin-right: 8px;
  }
  .vellano-hdr-burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: #111;
    transition: transform 0.3s, opacity 0.3s;
  }
  .vellano-hdr-burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .vellano-hdr-burger.open span:nth-child(2) { opacity: 0; }
  .vellano-hdr-burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .vellano-mobile-menu {
    position: fixed;
    top: 68px; /* mobile header height is usually smaller, but let's use 68px grid height */
    left: 0;
    width: 100%;
    height: calc(100vh - 68px);
    background: #F8F6F3;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 99;
    padding: 32px 5%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .vellano-mobile-menu.open {
    transform: translateX(0);
  }
  .vellano-mobile-menu-inner {
    flex: 1;
  }
  .vellano-mobile-nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading-family);
    font-size: 36px;
    font-weight: 400;
    color: #111;
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid #E8E4DF;
    transition: color 0.2s, padding-left 0.2s;
    letter-spacing: 1px;
  }
  .vellano-mobile-nav-link:last-of-type { border-bottom: none; }
  .vellano-mobile-nav-link:hover { color: #B8A07A; padding-left: 10px; }
  .vellano-mobile-sub-link {
    display: block;
    font-size: 16px;
    color: #777;
    text-decoration: none;
    padding: 10px 0 10px 20px;
    border-bottom: 1px solid #F0EDE9;
    transition: color 0.2s;
  }
  .vellano-mobile-sub-link:hover { color: #111; }
  .vellano-mobile-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 40px;
  }
  .vellano-mobile-cta-quiz {
    display: block;
    text-align: center;
    padding: 16px;
    border: 1.5px solid #111;
    border-radius: 30px;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #111;
    text-decoration: none;
  }
  .vellano-mobile-cta-shop {
    display: block;
    text-align: center;
    padding: 16px;
    background: #111;
    border-radius: 30px;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .vellano-hdr-inner {
      grid-template-columns: auto 1fr auto;
      padding: 0 5%;
    }
    .vellano-hdr-nav { display: none; }
    .vellano-hdr-logo { grid-column: 2; text-align: center; }
    .vellano-hdr-actions { grid-column: 3; }
    .vellano-hdr-btn-quiz, .vellano-hdr-btn-shop, .vellano-hdr-lang,
    .vellano-hdr-icon:not([aria-label="Cart"]) { display: none; }
    .vellano-hdr-burger { display: flex; grid-column: 1; }
  }
  @media (min-width: 961px) {
    .vellano-mobile-menu { display: none; }
    .vellano-hdr-burger { display: none; }
  }
{%- endstyle -%}

<!-- ===== HEADER ===== -->
<div class="vellano-hdr" id="vellano-hdr">
  <div class="vellano-hdr-inner">

    <!-- Mobile hamburger -->
    <button class="vellano-hdr-burger" id="vellano-burger" onclick="vellanoToggleMobileMenu()" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <!-- LEFT NAV (desktop) -->
    <nav class="vellano-hdr-nav" aria-label="Main">
      <!-- Mega Menu trigger -->
      <div class="vellano-hdr-dropdown-wrap">
        <a href="{{ routes.collections_url }}">
          Shop
          <svg viewBox="0 0 14 8" fill="none" width="10" height="6"><path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>

        <!-- MEGA MENU -->
        <div class="vellano-mega">
          <div class="vellano-mega-inner">

            <!-- Left: Categories -->
            <div class="vellano-mega-cats">
              <a class="vellano-mega-cat active" data-panel="system" href="{{ routes.collections_url }}">
                The System
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a class="vellano-mega-cat" data-panel="filters" href="{{ routes.collections_url }}">
                Filters
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a class="vellano-mega-cat" data-panel="bodycare" href="{{ routes.collections_url }}">
                Body Care
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a class="vellano-mega-cat" data-panel="accessories" href="{{ routes.collections_url }}">
                Accessories
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>

            <!-- Right: Product panels -->
            <div class="vellano-mega-panels">

              {%- assign system_handles = 'the-signature-filtered-shower-system,the-supercharged-adjustable-showerhead,the-ceramic-faucet-purifier' | split: ',' -%}
              {%- assign filter_handles = 'the-purifying-filter-cartridge' | split: ',' -%}
              {%- assign bodycare_handles = 'the-turmeric-kojic-brightening-bar,the-fragrant-rice-milk-cleansing-bar' | split: ',' -%}
              {%- assign accessory_handles = 'the-natural-bamboo-soap-dish,the-stainless-apothecary-dispenser' | split: ',' -%}

              <!-- The System -->
              <div class="vellano-mega-panel active" id="vellano-panel-system">
                {%- for handle in system_handles -%}
                  {%- assign p = all_products[handle] -%}
                  {%- if p != empty -%}
                    <a href="{{ p.url }}" class="vellano-mega-card">
                      {%- if p.featured_image -%}
                        <img class="vellano-mega-card-img" src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">
                      {%- else -%}
                        <div class="vellano-mega-card-img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                      {%- endif -%}
                      <div class="vellano-mega-card-name">{{ p.title }}</div>
                      <div class="vellano-mega-card-price">{{ p.price | money }}</div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
                <a href="/collections/all" class="vellano-mega-showall">View all <svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              </div>

              <!-- Filters -->
              <div class="vellano-mega-panel" id="vellano-panel-filters">
                {%- for handle in filter_handles -%}
                  {%- assign p = all_products[handle] -%}
                  {%- if p != empty -%}
                    <a href="{{ p.url }}" class="vellano-mega-card">
                      {%- if p.featured_image -%}
                        <img class="vellano-mega-card-img" src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">
                      {%- else -%}
                        <div class="vellano-mega-card-img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                      {%- endif -%}
                      <div class="vellano-mega-card-name">{{ p.title }}</div>
                      <div class="vellano-mega-card-price">{{ p.price | money }}</div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
                <a href="/collections/all" class="vellano-mega-showall">View all filters <svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              </div>

              <!-- Body Care -->
              <div class="vellano-mega-panel" id="vellano-panel-bodycare">
                {%- for handle in bodycare_handles -%}
                  {%- assign p = all_products[handle] -%}
                  {%- if p != empty -%}
                    <a href="{{ p.url }}" class="vellano-mega-card">
                      {%- if p.featured_image -%}
                        <img class="vellano-mega-card-img" src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">
                      {%- else -%}
                        <div class="vellano-mega-card-img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                      {%- endif -%}
                      <div class="vellano-mega-card-name">{{ p.title }}</div>
                      <div class="vellano-mega-card-price">{{ p.price | money }}</div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
                <a href="/collections/all" class="vellano-mega-showall">View all body care <svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              </div>

              <!-- Accessories -->
              <div class="vellano-mega-panel" id="vellano-panel-accessories">
                {%- for handle in accessory_handles -%}
                  {%- assign p = all_products[handle] -%}
                  {%- if p != empty -%}
                    <a href="{{ p.url }}" class="vellano-mega-card">
                      {%- if p.featured_image -%}
                        <img class="vellano-mega-card-img" src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">
                      {%- else -%}
                        <div class="vellano-mega-card-img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
                      {%- endif -%}
                      <div class="vellano-mega-card-name">{{ p.title }}</div>
                      <div class="vellano-mega-card-price">{{ p.price | money }}</div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
                <a href="/collections/all" class="vellano-mega-showall">View all accessories <svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              </div>

            </div>
          </div>
        </div>
        <!-- END MEGA MENU -->
      </div>

      <a href="/collections/all">The Collection</a>
      <a href="{{ pages['the-science'].url | default: '/pages/the-science' }}">The Science</a>
      <a href="{{ pages['quiz'].url | default: '/pages/quiz' }}">Take the Quiz</a>
    </nav>

    <!-- CENTER LOGO -->
    <a href="{{ routes.root_url }}" class="vellano-hdr-logo" aria-label="Vellano Home">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ section.settings.logo.alt | escape }}">
      {% elsif section.settings.logo_text != blank %}
        <div style="font-size: 24px; font-weight: bold;">{{ section.settings.logo_text }}</div>
      {% else %}
        <div style="font-size: 24px; font-weight: bold;">{{ shop.name }}</div>
      {% endif %}
    </a>

    <!-- RIGHT ACTIONS -->
    <div class="vellano-hdr-actions">
      <!-- Search -->
      {% render 'header-search', input_id: 'Vellano-Search' %}

      <!-- Account -->
      <a href="{{ routes.account_url }}" class="vellano-hdr-icon" aria-label="Account">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </a>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="vellano-hdr-icon" id="cart-icon-bubble" aria-label="Cart">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
      </a>
    </div>

  </div>
</div>

<!-- ===== MOBILE FULL-SCREEN MENU ===== -->
<div class="vellano-mobile-menu" id="vellano-mobile-menu">
  <div class="vellano-mobile-menu-inner">
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}" class="vellano-mobile-nav-link" onclick="vellanoToggleMobileMenu()">
        {{ link.title }}
        {% if link.links != blank %}
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        {% endif %}
      </a>
      {% if link.links != blank %}
        {% for childlink in link.links %}
          <a href="{{ childlink.url }}" class="vellano-mobile-sub-link" onclick="vellanoToggleMobileMenu()">→ {{ childlink.title }}</a>
        {% endfor %}
      {% endif %}
    {% endfor %}
    <a href="{{ pages['about'].url | default: routes.root_url }}" class="vellano-mobile-nav-link" onclick="vellanoToggleMobileMenu()">About Vellano</a>
  </div>

  <div class="vellano-mobile-ctas">
    {% if section.settings.mobile_hero != blank %}
      <img src="{{ section.settings.mobile_hero | image_url: width: 800 }}" style="width: 100%; height: 180px; object-fit: cover; border-radius: 12px; margin-bottom: 12px;" alt="{{ section.settings.mobile_hero.alt | escape }}">
    {% else %}
      <div style="width: 100%; height: 180px; border-radius: 12px; margin-bottom: 12px; background: rgba(var(--color-foreground), 0.04);"></div>
    {% endif %}
    <a href="{{ pages['quiz'].url | default: '/pages/quiz' }}" class="vellano-mobile-cta-quiz" onclick="vellanoToggleMobileMenu()">Take The Quiz</a>
    <a href="{{ routes.collections_url }}" class="vellano-mobile-cta-shop" onclick="vellanoToggleMobileMenu()">Shop The Collection</a>
  </div>
</div>

<script>
  // Mega menu — open/close controlled by JS only (not CSS hover)
  var vellanoMegaWrap = document.querySelector('.vellano-hdr-dropdown-wrap');
  var vellanoMega = document.querySelector('.vellano-mega');
  var vellanoCloseTimer = null;

  function vellanoOpenMega() {
    clearTimeout(vellanoCloseTimer);
    if (vellanoMega) vellanoMega.classList.add('is-open');
  }
  function vellanoCloseMega() {
    vellanoCloseTimer = setTimeout(function() {
      if (vellanoMega) vellanoMega.classList.remove('is-open');
    }, 120);
  }

  if (vellanoMegaWrap) {
    vellanoMegaWrap.addEventListener('mouseenter', vellanoOpenMega);
    vellanoMegaWrap.addEventListener('mouseleave', vellanoCloseMega);
  }
  if (vellanoMega) {
    vellanoMega.addEventListener('mouseenter', vellanoOpenMega);
    vellanoMega.addEventListener('mouseleave', vellanoCloseMega);
  }

  // Category panel switching
  document.querySelectorAll('.vellano-mega-cat').forEach(function(cat) {
    cat.addEventListener('mouseenter', function() {
      var panel = this.dataset.panel;
      document.querySelectorAll('.vellano-mega-cat').forEach(function(c) { c.classList.remove('active'); });
      document.querySelectorAll('.vellano-mega-panel').forEach(function(p) { p.classList.remove('active'); });
      this.classList.add('active');
      var target = document.getElementById('vellano-panel-' + panel);
      if (target) target.classList.add('active');
    });
  });

  // Close on scroll
  window.addEventListener('scroll', function() {
    if (vellanoMega) vellanoMega.classList.remove('is-open');
  }, { passive: true });

  function vellanoToggleMobileMenu() {
    const burger = document.getElementById('vellano-burger');
    const menu = document.getElementById('vellano-mobile-menu');
    burger.classList.toggle('open');
    menu.classList.toggle('open');
    document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
  }

  // Reveal on scroll up logic
  let lastScrollTop = 0;
  const header = document.querySelector('.vellano-hdr');
  
  window.addEventListener('scroll', () => {
    let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    if (scrollTop > lastScrollTop && scrollTop > 100) {
      // Scrolling down & past top -> fade out / slide up
      header.style.transform = 'translateY(-100%)';
      header.style.opacity = '0';
    } else {
      // Scrolling up -> fade in / slide down
      header.style.transform = 'translateY(0)';
      header.style.opacity = '1';
    }
    lastScrollTop = scrollTop;
  });
</script>

