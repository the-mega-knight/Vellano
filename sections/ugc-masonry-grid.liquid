<style>
  .ugc-grid-section {
    padding: 8rem 2rem;
    background-color: rgb(var(--color-background));
  }
  .ugc-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .ugc-title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-family: var(--font-heading-family);
    margin-bottom: 1.5rem;
    color: rgb(var(--color-foreground));
  }
  .ugc-subtitle {
    font-size: 1.8rem;
    color: rgba(var(--color-foreground), 0.7);
    max-width: 600px;
    margin: 0 auto;
  }
  .ugc-masonry {
    column-count: 1;
    column-gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }
  @media (min-width: 600px) { .ugc-masonry { column-count: 2; } }
  @media (min-width: 900px) { .ugc-masonry { column-count: 3; } }
  @media (min-width: 1200px) { .ugc-masonry { column-count: 4; } }
  
  .ugc-item {
    break-inside: avoid;
    margin-bottom: 20px;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.03);
    display: block;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ugc-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  .ugc-item-inner {
    position: relative;
    width: 100%;
  }
  /* Enforce alternating aspect ratios for true masonry look */
  .ugc-item:nth-child(4n + 1) .ugc-item-inner { padding-bottom: 140%; } /* Tall */
  .ugc-item:nth-child(4n + 2) .ugc-item-inner { padding-bottom: 100%; } /* Square */
  .ugc-item:nth-child(4n + 3) .ugc-item-inner { padding-bottom: 125%; } /* Medium */
  .ugc-item:nth-child(4n + 0) .ugc-item-inner { padding-bottom: 160%; } /* Extra Tall */
  
  .ugc-item img, .ugc-item video, .placeholder-svg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  .ugc-item-overlay {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 3rem 2rem 2rem;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    color: white;
    z-index: 2;
    pointer-events: none;
  }
  .ugc-item-username {
    font-family: var(--font-body-family), sans-serif;
    font-weight: 500;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.5px;
  }
  .ugc-item-username svg {
    width: 16px; height: 16px;
    fill: #3b82f6;
  }
  .ugc-play-icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 48px; height: 48px;
    fill: white;
    opacity: 0.9;
    z-index: 2;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
    pointer-events: none;
  }
  .placeholder-svg {
    fill: rgba(var(--color-foreground), 0.08);
  }
</style>

<div class="ugc-grid-section">
  <div class="ugc-header">
    <h2 class="ugc-title">{{ section.settings.heading }}</h2>
    <p class="ugc-subtitle">{{ section.settings.subheading }}</p>
  </div>
  
  <div class="ugc-masonry">
    {% for block in section.blocks %}
      <div class="ugc-item">
        <div class="ugc-item-inner">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.username }}" loading="lazy">
          {% else %}
            {% assign placeholder_index = forloop.index | modulo: 2 | plus: 1 %}
            {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          
          {% if block.settings.is_video %}
            <svg class="ugc-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          {% endif %}
        </div>
        
        <div class="ugc-item-overlay">
          <div class="ugc-item-username">
            @{{ block.settings.username | default: 'customer' }}
            <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
        </div>
      </div>
    {% endfor %}
    
    {% if section.blocks.size == 0 %}
      <!-- Placeholders if no blocks -->
      {% for i in (1..8) %}
        <div class="ugc-item">
          <div class="ugc-item-inner">
            {% assign collection_index = i | modulo: 6 | plus: 1 %}
            {{ 'collection-' | append: collection_index | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="ugc-item-overlay"><div class="ugc-item-username">@vellano_fan <svg viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div></div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "UGC Masonry Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results from Real People"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join 10,000+ others who upgraded their shower."
    }
  ],
  "blocks": [
    {
      "type": "ugc_post",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or Video Thumbnail"
        },
        {
          "type": "text",
          "id": "username",
          "label": "Instagram/TikTok Username"
        },
        {
          "type": "checkbox",
          "id": "is_video",
          "label": "Show Play Icon (Video)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Masonry Grid",
      "blocks": [
        { "type": "ugc_post" },
        { "type": "ugc_post" },
        { "type": "ugc_post" },
        { "type": "ugc_post" },
        { "type": "ugc_post" },
        { "type": "ugc_post" }
      ]
    }
  ]
}
{% endschema %}
