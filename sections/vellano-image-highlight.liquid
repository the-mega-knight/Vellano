{%- style -%}
  .vellano-highlight {
    width: 100%;
    height: 70vh;
    min-height: 500px;
    position: relative;
    overflow: hidden;
    background-color: #F8F6F3;
  }
  .vellano-highlight img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
{%- endstyle -%}

<div class="vellano-highlight vellano-animate">
  {% if section.settings.bg_image != blank %}
    <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" class="vellano-hero-bg" alt="{{ section.settings.bg_image.alt | escape }}">
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'vellano-hero-bg placeholder-svg' }}
  {% endif %}
</div>

{% schema %}
{
  "name": "Vellano Image Highlight",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [ { "name": "Vellano Image Highlight" } ]
}
{% endschema %}