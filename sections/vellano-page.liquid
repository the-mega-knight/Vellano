{%- style -%}
  .vellano-page-wrap { max-width: 900px; margin: 100px auto; padding: 0 5%; font-family: 'Jost', sans-serif; color: #555; line-height: 1.8; }
  .vellano-page-title { font-family: 'Bodoni Moda', serif; font-size: 48px; color: #111111; text-align: center; margin-bottom: 60px; font-weight: 400; }
  .vellano-page-content h2 { font-family: 'Bodoni Moda', serif; font-size: 28px; color: #111111; margin-top: 50px; margin-bottom: 20px; }
  .vellano-page-content p { margin-bottom: 25px; }
  .vellano-page-content img { width: 100%; border-radius: 16px; margin: 40px 0; }
{%- endstyle -%}

<div class="vellano-page-wrap vellano-animate-fade-up">
  <h1 class="vellano-page-title">{{ page.title | escape }}</h1>
  <div class="vellano-page-content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Vellano Page",
  "settings": []
}
{% endschema %}
