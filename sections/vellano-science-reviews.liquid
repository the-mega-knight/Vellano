{%- style -%}
  .vellano-science {
    background: #F8F6F3;
    color: #111;
    overflow: hidden;
  }

  /* INTRO */
  .vellano-sci-intro-block {
    padding: 120px 5% 80px;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
  }
  .vellano-sci-eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #B8A07A;
    margin-bottom: 28px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vellano-sci-eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: #B8A07A;
  }
  .vellano-sci-main-title {
    font-family: var(--font-heading-family);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 400;
    line-height: 1.05;
    color: #111;
    margin: 0;
  }
  .vellano-sci-intro-right { padding-bottom: 8px; }
  .vellano-sci-intro-text {
    font-size: 17px;
    line-height: 1.75;
    color: rgba(17,17,17,0.55);
    margin-bottom: 36px;
  }
  .vellano-sci-intro-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #B8A07A;
    text-decoration: none;
    font-weight: 500;
    transition: gap 0.25s;
  }
  .vellano-sci-intro-link:hover { gap: 16px; }

  /* STATS */
  .vellano-sci-stats-wrapper {
    border-top: 1px solid rgba(17,17,17,0.08);
    border-bottom: 1px solid rgba(17,17,17,0.08);
  }
  .vellano-sci-stats-bar {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .vellano-sci-stat {
    padding: 60px 0;
    position: relative;
  }
  .vellano-sci-stat + .vellano-sci-stat::before {
    content: '';
    position: absolute;
    left: 0; top: 20%; height: 60%; width: 1px;
    background: rgba(17,17,17,0.08);
  }
  .vellano-sci-stat:nth-child(2),
  .vellano-sci-stat:nth-child(3) { padding-left: 48px; }
  .vellano-sci-stat-num {
    font-family: var(--font-heading-family);
    font-size: clamp(56px, 7vw, 96px);
    font-weight: 400;
    color: #111;
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }
  .vellano-sci-stat-num span { color: #B8A07A; }
  .vellano-sci-stat-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #B8A07A;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .vellano-sci-stat-desc {
    font-size: 13px;
    color: rgba(17,17,17,0.5);
    line-height: 1.6;
    max-width: 240px;
  }

  /* FEATURES */
  .vellano-sci-features {
    padding: 100px 5%;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
  }
  .vellano-sci-feat {
    padding: 48px 48px 48px 0;
    border-right: 1px solid rgba(17,17,17,0.08);
  }
  .vellano-sci-feat:nth-child(2) { padding-left: 48px; }
  .vellano-sci-feat:last-child { border-right: none; padding-right: 0; padding-left: 48px; }
  .vellano-sci-feat-num {
    font-family: var(--font-heading-family);
    font-size: 13px;
    color: rgba(17,17,17,0.3);
    margin-bottom: 32px;
    letter-spacing: 2px;
  }
  .vellano-sci-feat-icon {
    width: 44px; height: 44px;
    border: 1px solid rgba(184,160,122,0.3);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 28px;
    color: #B8A07A;
  }
  .vellano-sci-feat-icon svg { width: 20px; height: 20px; }
  .vellano-sci-feat-title {
    font-family: var(--font-heading-family);
    font-size: 22px; font-weight: 400; color: #111;
    margin-bottom: 16px; line-height: 1.25;
  }
  .vellano-sci-feat-text { font-size: 14px; color: rgba(17,17,17,0.6); line-height: 1.75; }

  /* SPLIT */
  .vellano-sci-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 600px;
    border-top: 1px solid rgba(17,17,17,0.08);
  }
  .vellano-sci-split-img-wrap {
    overflow: hidden;
    position: relative;
    margin: 24px 0 24px 24px;
    border-radius: 24px;
    background: #E8E4DF;
    display: flex; align-items: center; justify-content: center;
  }
  .vellano-sci-split-img-placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 100%; height: 100%; min-height: 500px;
    padding: 40px;
    text-align: center;
  }
  .vellano-sci-split-img-placeholder-icon {
    width: 64px; height: 64px;
    border: 1.5px solid rgba(184,160,122,0.4);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 24px;
    color: #B8A07A;
  }
  .vellano-sci-split-img-placeholder-icon svg { width: 28px; height: 28px; }
  .vellano-sci-split-img-placeholder-title {
    font-family: var(--font-heading-family);
    font-size: 20px; color: #111; font-weight: 400; margin-bottom: 12px;
  }
  .vellano-sci-split-img-placeholder-sub {
    font-size: 13px; color: rgba(17,17,17,0.45); line-height: 1.6; max-width: 260px;
  }
  .vellano-sci-split-content {
    padding: 80px 8%;
    display: flex; flex-direction: column; justify-content: center;
    background: #fff;
  }
  .vellano-sci-split-eyebrow {
    font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
    color: #B8A07A; margin-bottom: 22px; font-weight: 500;
  }
  .vellano-sci-split-title {
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.5vw, 36px); font-weight: 400; color: #111;
    margin-bottom: 24px; line-height: 1.25;
  }
  .vellano-sci-split-body {
    font-size: 15px; color: rgba(17,17,17,0.6); line-height: 1.75; margin-bottom: 40px;
  }
  .vellano-sci-fact-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 44px; }
  .vellano-sci-fact-item {
    display: flex; align-items: flex-start; gap: 14px;
    font-size: 14px; color: rgba(17,17,17,0.6); line-height: 1.5;
  }
  .vellano-sci-fact-check {
    width: 20px; height: 20px; border-radius: 50%;
    border: 1.5px solid #B8A07A;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 1px; color: #B8A07A; font-size: 10px;
  }
  .vellano-sci-split-link {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
    color: #B8A07A; text-decoration: none; font-weight: 500; transition: gap 0.25s;
  }
  .vellano-sci-split-link:hover { gap: 16px; }

  /* CTA */
  .vellano-sci-cta-block { background: #111; padding: 100px 5%; text-align: center; }
  .vellano-sci-cta-inner { max-width: 700px; margin: 0 auto; }
  .vellano-sci-cta-eyebrow {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: #B8A07A; margin-bottom: 24px; font-weight: 500;
  }
  .vellano-sci-cta-title {
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 3.5vw, 48px); font-weight: 400; color: #F8F6F3;
    line-height: 1.1; margin-bottom: 44px;
  }
  .vellano-sci-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .vellano-sci-cta-btn {
    display: inline-flex; align-items: center;
    padding: 15px 36px; border-radius: 30px;
    font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px;
    font-weight: 600; text-decoration: none; transition: all 0.25s;
  }
  .vellano-sci-cta-btn--primary { background: #B8A07A; color: #111; }
  .vellano-sci-cta-btn--primary:hover { background: #c9b28e; }
  .vellano-sci-cta-btn--ghost { background: transparent; color: #F8F6F3; border: 1.5px solid rgba(248,246,243,0.25); }
  .vellano-sci-cta-btn--ghost:hover { border-color: #F8F6F3; }

  /* ANIMATIONS */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s cubic-bezier(0.16,1,0.3,1), transform 0.75s cubic-bezier(0.16,1,0.3,1);
  }
  [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  [data-reveal][data-delay="1"] { transition-delay: 0.1s; }
  [data-reveal][data-delay="2"] { transition-delay: 0.2s; }
  [data-reveal][data-delay="3"] { transition-delay: 0.3s; }

  @media (max-width: 900px) {
    .vellano-sci-intro-block { grid-template-columns: 1fr; gap: 32px; padding: 80px 6% 60px; }
    .vellano-sci-stats-bar { grid-template-columns: 1fr; }
    .vellano-sci-stat + .vellano-sci-stat::before { width: 60%; height: 1px; top: 0; left: 20%; }
    .vellano-sci-features { grid-template-columns: 1fr; padding: 60px 6%; }
    .vellano-sci-feat { border-right: none; border-bottom: 1px solid rgba(17,17,17,0.08); padding: 40px 0; }
    .vellano-sci-feat:last-child { border-bottom: none; }
    .vellano-sci-feat:nth-child(2), .vellano-sci-feat:last-child { padding-left: 0; }
    .vellano-sci-split { grid-template-columns: 1fr; }
    .vellano-sci-split-img-wrap { min-height: 320px; margin: 0; border-radius: 0; }
  }
{%- endstyle -%}

<div class="vellano-science" id="vellano-science">

  <!-- INTRO -->
  <div class="vellano-sci-intro-block">
    <div class="vellano-sci-intro-left" data-reveal>
      <p class="vellano-sci-eyebrow">The Science Behind It</p>
      <h2 class="vellano-sci-main-title">Your water is<br>the problem.<br>We solved it.</h2>
    </div>
    <div class="vellano-sci-intro-right" data-reveal data-delay="1">
      <p class="vellano-sci-intro-text">Most shower water contains chlorine, heavy metals, and hard mineral deposits. These are not just cosmetic concerns &mdash; they are measurable damage to your hair&apos;s cuticle and your skin&apos;s barrier function. No serum or conditioner fixes what happens upstream.</p>
      <a href="/collections/all" class="vellano-sci-intro-link">Explore the full system &rarr;</a>
    </div>
  </div>

  <!-- STATS -->
  <div class="vellano-sci-stats-wrapper">
    <div class="vellano-sci-stats-bar">
      <div class="vellano-sci-stat" data-reveal>
        <div class="vellano-sci-stat-num">98<span>%</span></div>
        <div class="vellano-sci-stat-label">Chlorine Removed</div>
        <div class="vellano-sci-stat-desc">KDF-55 oxidation-reduction eliminates chlorine within milliseconds of contact at any water temperature.</div>
      </div>
      <div class="vellano-sci-stat" data-reveal data-delay="1">
        <div class="vellano-sci-stat-num">14<span> days</span></div>
        <div class="vellano-sci-stat-label">To Noticeable Results</div>
        <div class="vellano-sci-stat-desc">Most customers report measurably softer hair and skin within two weeks of consistent use.</div>
      </div>
      <div class="vellano-sci-stat" data-reveal data-delay="2">
        <div class="vellano-sci-stat-num">6<span>mo</span></div>
        <div class="vellano-sci-stat-label">Filter Lifespan</div>
        <div class="vellano-sci-stat-desc">Each cartridge handles up to 10,000 gallons before performance drops below threshold &mdash; no early replacing.</div>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="vellano-sci-features">
    <div class="vellano-sci-feat" data-reveal>
      <div class="vellano-sci-feat-num">01</div>
      <div class="vellano-sci-feat-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
      </div>
      <h3 class="vellano-sci-feat-title">KDF-55 Electrochemical Filtration</h3>
      <p class="vellano-sci-feat-text">High-purity copper-zinc alloy strips chlorine, chloramines, and heavy metals through a redox reaction &mdash; no chemicals, no maintenance, just physics working in your favour. The same technology used in clinical-grade water purification.</p>
    </div>
    <div class="vellano-sci-feat" data-reveal data-delay="1">
      <div class="vellano-sci-feat-num">02</div>
      <div class="vellano-sci-feat-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-10h-1M4.34 12h-1m15.07-6.07-.707.707M6.343 17.657l-.707.707m12.728 0-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10A5 5 0 0012 7z"/></svg>
      </div>
      <h3 class="vellano-sci-feat-title">4-Level Activated Carbon Core</h3>
      <p class="vellano-sci-feat-text">The Signature Filtered Shower System runs water through four sequential filtration stages before it reaches your skin. Each stage targets a different contaminant class &mdash; from dissolved chlorine to suspended sediment to residual mineral scale.</p>
    </div>
    <div class="vellano-sci-feat" data-reveal data-delay="2">
      <div class="vellano-sci-feat-num">03</div>
      <div class="vellano-sci-feat-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="vellano-sci-feat-title">Ceramic Membrane Barrier</h3>
      <p class="vellano-sci-feat-text">The Ceramic Faucet Purifier extends your water defence to the sink &mdash; where you wash your face. Its advanced ceramic membrane traps micro-impurities at 0.1 micron and inhibits scale buildup, so your skincare routine starts with clean water, not the problem.</p>
    </div>
  </div>

  <!-- SPLIT -->
  <div class="vellano-sci-split">
    <div class="vellano-sci-split-img-wrap" data-reveal>
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" class="vellano-sci-split-img" alt="{{ section.settings.image.alt | escape }}">
      {% else %}
        <div class="vellano-sci-split-img-placeholder">
          <div class="vellano-sci-split-img-placeholder-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-1.2 5.4-6 8.1-6 12a6 6 0 0012 0c0-3.9-4.8-6.6-6-12z"/></svg>
          </div>
          <p class="vellano-sci-split-img-placeholder-title">Add a brand image</p>
          <p class="vellano-sci-split-img-placeholder-sub">Upload via the Shopify Customizer &mdash; Themes &rarr; The Science &rarr; How It Works image</p>
        </div>
      {% endif %}
    </div>
    <div class="vellano-sci-split-content" data-reveal data-delay="1">
      <p class="vellano-sci-split-eyebrow">How It Actually Works</p>
      <h3 class="vellano-sci-split-title">The shower is the highest-exposure point in your entire skincare routine.</h3>
      <p class="vellano-sci-split-body">The average shower runs 8 minutes. At that rate, your skin is in continuous contact with chlorinated, mineral-laden water for over 45 hours per month. No serum reverses that upstream. We filter it before it touches you.</p>
      <div class="vellano-sci-fact-list">
        <div class="vellano-sci-fact-item">
          <span class="vellano-sci-fact-check">&#10003;</span>
          <span>Removes up to 98% of chlorine and chloramines at point of contact</span>
        </div>
        <div class="vellano-sci-fact-item">
          <span class="vellano-sci-fact-check">&#10003;</span>
          <span>Reduces dissolved heavy metals: lead, mercury, iron, and cadmium</span>
        </div>
        <div class="vellano-sci-fact-item">
          <span class="vellano-sci-fact-check">&#10003;</span>
          <span>Inhibits calcium scale buildup that coats hair follicles and skin</span>
        </div>
        <div class="vellano-sci-fact-item">
          <span class="vellano-sci-fact-check">&#10003;</span>
          <span>No electricity, no installation tools &mdash; purely mechanical filtration</span>
        </div>
        <div class="vellano-sci-fact-item">
          <span class="vellano-sci-fact-check">&#10003;</span>
          <span>Six-month cartridge lifespan, rated to 10,000 gallons per filter</span>
        </div>
      </div>
      <a href="/collections/all" class="vellano-sci-split-link">Explore The Collection &rarr;</a>
    </div>
  </div>

  <!-- CTA -->
  <div class="vellano-sci-cta-block" data-reveal>
    <div class="vellano-sci-cta-inner">
      <p class="vellano-sci-cta-eyebrow">Ready to Act on the Science?</p>
      <h2 class="vellano-sci-cta-title">Stop showering in what you are trying to wash off.</h2>
      <div class="vellano-sci-cta-btns">
        <a href="/pages/quiz" class="vellano-sci-cta-btn vellano-sci-cta-btn--primary">Take the Quiz &rarr;</a>
        <a href="/collections/all" class="vellano-sci-cta-btn vellano-sci-cta-btn--ghost">Explore the Collection</a>
      </div>
    </div>
  </div>

</div>

<script>
(function() {
  if (!('IntersectionObserver' in window)) {
    document.querySelectorAll('[data-reveal]').forEach(function(el) { el.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('[data-reveal]').forEach(function(el) { io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Vellano Science",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "How It Works Image" }
  ],
  "presets": [{ "name": "Vellano Science" }]
}
{% endschema %}