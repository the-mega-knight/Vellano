<style>
.vellano-mega-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 100%;
}
.vellano-mega-button {
  background: none;
  border: none;
  font-family: inherit;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1px;
  color: #111111;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  height: 100%;
  padding: 0 16px;
  text-transform: uppercase;
}
.vellano-mega-menu {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: #fff;
  width: 750px;
  border-radius: 6px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.08);
  border: 1px solid #eee;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 9999;
}
.vellano-mega-wrapper:hover .vellano-mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}
.vellano-mega-inner {
  display: flex;
  padding: 40px;
  gap: 40px;
}
.vellano-mega-links {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 180px;
  border-right: 1px solid #eee;
  padding-right: 20px;
}
.vellano-mega-title {
  font-size: 10px;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}
.vellano-mega-links a {
  font-size: 13px;
  color: #111111;
  text-decoration: none;
  transition: color 0.2s;
}
.vellano-mega-links a:hover {
  color: #cda274;
}
.vellano-mega-products {
  display: flex;
  gap: 20px;
  flex: 1;
}
.vellano-mega-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: transform 0.2s;
}
.vellano-mega-card:hover {
  transform: translateY(-4px);
}
.vellano-mega-img {
  width: 100%;
  aspect-ratio: 1;
  background: #fafafa;
  border-radius: 4px;
  margin-bottom: 16px;
  overflow: hidden;
}
.vellano-mega-img img, .vellano-mega-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.vellano-mega-kicker {
  font-size: 10px;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 4px;
}
.vellano-mega-name {
  font-size: 14px;
  font-weight: 600;
  color: #111111;
  margin-bottom: 8px;
}
.vellano-mega-shop {
  font-size: 13px;
  color: #cda274;
}
</style>

