<script>
  // Simple countdown logic
  (function() {
    let minutes = 9;
    let seconds = 59;
    setInterval(() => {
      seconds--;
      if (seconds < 0) {
        seconds = 59;
        minutes--;
      }
      if (minutes < 0) {
        minutes = 0;
        seconds = 0;
      }
      const blocks = document.querySelectorAll('.vellano-custom-sticky-timer .vellano-timer-block');
      if(blocks.length === 3) {
        blocks[1].childNodes[0].nodeValue = minutes.toString().padStart(2, '0');
        blocks[2].childNodes[0].nodeValue = seconds.toString().padStart(2, '0');
      }
    }, 1000);
  })();
</script>

