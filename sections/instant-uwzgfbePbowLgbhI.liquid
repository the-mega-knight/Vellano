  <style>
  html { scroll-behavior: smooth; }

    #icLJfWgFAVKjRqFmO {
      position: sticky;
      top: 0;
      z-index: 100;
      transition: transform 0.3s ease-in-out;
    }
    #icLJfWgFAVKjRqFmO.header-hidden {
