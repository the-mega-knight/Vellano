    }
  
    /* Instant Dropdown Smooth Animation */
    [data-instant-type="dropdown"][data-instant-state="active"],
    [data-instant-type="popover"][data-instant-state="active"],
    [data-instant-state="active"] > [data-instant-type="container"] {
      animation: vellanoFadeInDown 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      transform-origin: top center;
    }

    @keyframes vellanoFadeInDown {
      0% {
        opacity: 0;
        transform: translateY(-8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
