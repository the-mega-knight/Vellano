{%- style -%}
  .vellano-footer {
    background: #F8F6F3;
    color: #111;
    padding: 80px 5% 40px;
    font-family: 'Jost', sans-serif;
  }
  .vellano-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
    border-bottom: 1px solid #E8E4DF;
    padding-bottom: 60px;
  }
  .vellano-footer-col h4 {
    font-family: 'Bodoni Moda', serif;
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 24px;
    color: #111;
  }
  .vellano-footer-col p {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    max-width: 300px;
    margin-bottom: 24px;
  }
  .vellano-footer-link {
    display: block;
    color: #555;
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 12px;
    transition: color 0.2s;
  }
  .vellano-footer-link:hover { color: #111; }
  .vellano-footer-newsletter {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .vellano-footer-input {
    background: #fff;
    border: 1px solid #E8E4DF;
    border-radius: 4px;
    padding: 12px 16px;
    color: #111;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    flex: 1;
  }
  .vellano-footer-submit {
    background: #111;
    color: #F8F6F3;
    border: none;
    border-radius: 4px;
    padding: 12px 20px;
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .vellano-footer-submit:hover { background: #B8A07A; color: #fff; }
  .vellano-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 40px auto 0;
    font-size: 12px;
    color: #777;
  }
  .vellano-footer-badges {
    display: flex;
    gap: 12px;
  }
  .vellano-footer-badges svg {
    height: 24px;
    opacity: 0.7;
  }

  @media (max-width: 960px) {
    .vellano-footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .vellano-footer-grid { grid-template-columns: 1fr; }
    .vellano-footer-bottom { flex-direction: column; gap: 20px; text-align: center; }
  }
{%- endstyle -%}

<footer class="vellano-footer">
  <div class="vellano-footer-grid">
    <div class="vellano-footer-col">
      <div class="vellano-footer-block">
        <img src="{{ 'vellano_logo_black.png' | asset_url }}" alt="Vellano" style="width: 160px; height: auto; display: block; margin-bottom: 20px;">
        <div class="vellano-footer-desc">Premium shower hardware for skin and hair health. Elevated daily rituals.</div>
      </div>
    </div>
    <div class="vellano-footer-col">
      <h4>Shop</h4>
      <a href="/products/vellano-filtered-showerhead-starter-kit" class="vellano-footer-link">The Starter Kit</a>
      <a href="/products/1-year-filter-supply" class="vellano-footer-link">Filter Refills</a>
      <a href="/products/vellano-hard-water-body-cleanser" class="vellano-footer-link">Body Cleanser</a>
      <a href="/products/vitamin-c-infusion-attachment" class="vellano-footer-link">Vitamin C Attachment</a>
    </div>
    <div class="vellano-footer-col">
      <h4>Support</h4>
      <a href="/?view=about" class="vellano-footer-link">Our Story</a>
      <a href="/?view=science" class="vellano-footer-link">The Science</a>
      <a href="/pages/contact" class="vellano-footer-link">Contact Us</a>
      <a href="/pages/faq" class="vellano-footer-link">FAQ</a>
    </div>
    <div class="vellano-footer-col">
      <h4>Join The Ritual</h4>
      <p>Subscribe for 15% off your first order and exclusive access to new products.</p>
      {% form 'customer', class: 'vellano-footer-newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="vellano-footer-input" placeholder="Email Address" required>
        <button type="submit" class="vellano-footer-submit">→</button>
      {% endform %}
    </div>
  </div>

  <div class="vellano-footer-bottom">
    <div>&copy; {{ 'now' | date: '%Y' }} Vellano. All rights reserved.</div>
    <div class="vellano-footer-badges">
      <!-- Shopify Payment Icons Loop -->
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      {%- endfor -%}
    </div>
    <div style="display: flex; align-items: center; gap: 24px;">
      <div class="vellano-hdr-lang" style="position: relative;">
        <button class="vellano-hdr-lang-btn" style="background: none; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #777; display: flex; align-items: center; gap: 3px; padding: 6px 0;">
          EN
          <svg width="8" height="5" fill="none" viewBox="0 0 8 5"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div>
        <a href="/pages/terms-of-service" style="color:inherit; text-decoration:none; margin-right: 12px;">Terms of Service</a>
        <a href="/pages/privacy-policy" style="color:inherit; text-decoration:none;">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Vellano Footer",
  "presets": [{ "name": "Vellano Footer" }]
}
{% endschema %}