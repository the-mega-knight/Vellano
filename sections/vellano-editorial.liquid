{%- style -%}
  .vellano-editorial {
    padding: 100px 5%;
    background: #F8F6F3;
  }
  .vellano-ed-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
    flex-direction: {% if section.settings.image_alignment == 'right' %}row-reverse{% else %}row{% endif %};
  }
  .vellano-ed-text-side { flex: 1; }
  .vellano-ed-img-side { flex: 1; }
  .vellano-ed-img {
    width: 100%;
    border-radius: 4px;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }
  .vellano-ed-title {
    font-family: var(--font-heading-family);
    font-size: clamp(32px, 3.5vw, 48px);
    line-height: 1.2;
    font-weight: 400;
    color: #111111;
    margin-bottom: 28px;
  }
  .vellano-ed-desc {
    font-size: 18px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 36px;
  }
  .vellano-ed-btn {
    display: inline-block;
    background: #111111;
    color: #F8F6F3;
    border: 1px solid #111111;
    padding: 14px 32px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .vellano-ed-btn:hover {
    background: #B8A07A;
    border-color: #B8A07A;
    color: #111;
  }
  @media (max-width: 900px) {
    .vellano-ed-container { flex-direction: column; gap: 40px; text-align: center; }
  }
{%- endstyle -%}

<div class="vellano-editorial vellano-animate">
  <div class="vellano-ed-container">
    <div class="vellano-ed-text-side vellano-animate-slide-right">
      <h2 class="vellano-ed-title">{{ section.settings.title | default: "Editorial Title" }}</h2>
      {% if section.settings.description != blank %}
        <div class="vellano-ed-desc">{{ section.settings.description }}</div>
      {% endif %}
      <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="vellano-ed-btn">
        {{ section.settings.btn_text | default: 'Shop Now' }}
      </a>
    </div>
    <div class="vellano-ed-img-side vellano-animate-slide-left vellano-animate-stagger-2">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" class="vellano-ed-img" alt="{{ section.settings.image.alt | escape | default: section.settings.title }}">
      {% else %}
        <img src="{{ 'vellano_science_water.png' | asset_url }}" class="vellano-ed-img" alt="Vellano filtered water">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vellano Editorial (HK)",
  "settings": [
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "Title" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "btn_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Vellano Editorial (HK)" }
  ]
}
{% endschema %}