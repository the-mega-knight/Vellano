{%- style -%}
  .vellano-editorial {
    padding: 100px 5%;
    background: #F8F6F3;
    font-family: 'Jost', sans-serif;
  }
    .vellano-ed-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
    flex-direction: {% if section.settings.image_alignment == 'right' %}row-reverse{% else %}row{% endif %};
  }
  .vellano-ed-text-side {
    flex: 1;
  }
  .vellano-ed-img-side {
    flex: 1;
  }
  .vellano-ed-img {
    width: 100%;
    border-radius: 4px;
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .vellano-ed-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 32px;
    line-height: 1.3;
    font-weight: 400;
    color: #111111;
    margin-bottom: 24px;
  }
  .vellano-ed-desc { font-size: 16px; line-height: 1.6; color: #555; margin-bottom: 30px; }
  .vellano-ed-btn {
    display: inline-block;
    background: #111111;
    color: #F8F6F3; border: 1px solid #111111;
    padding: 14px 32px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: background 0.3s ease;
  }
  .vellano-ed-btn:hover {
    background: #333;
  }
  @media (max-width: 900px) {
    .vellano-ed-container { flex-direction: column; gap: 40px; text-align: center; }
  }
{%- endstyle -%}

<div class="vellano-editorial vellano-animate">
  <div class="vellano-ed-container">
    <div class="vellano-ed-text-side vellano-animate-slide-right">
      <h2 class="vellano-ed-title">{{ section.settings.title | default: "Editorial Title" }}</h2>
      {% if section.settings.description != blank %}<div class="vellano-ed-desc">{{ section.settings.description }}</div>{% endif %}
      <a href="{{ section.settings.btn_link | default: '/?view=science' }}" class="vellano-ed-btn">
        {{ section.settings.btn_text | default: 'Expert Advice' }}
      </a>
    </div>
    <div class="vellano-ed-img-side vellano-animate-slide-left vellano-animate-stagger-2">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: 'master' }}" class="vellano-ed-img" alt="Editorial">
      {% elsif section.settings.fallback_image_url != blank %}
        {% if section.settings.fallback_image_url contains 'http' %}
          <img src="{{ section.settings.fallback_image_url }}" class="vellano-ed-img" alt="Editorial">
        {% else %}
          <img src="{{ section.settings.fallback_image_url | asset_url }}" class="vellano-ed-img" alt="Editorial">
        {% endif %}
      {% else %}
        <img src="{{ 'vellano_water_flow.png' | asset_url }}" class="vellano-ed-img" alt="Vellano Editorial">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vellano Editorial (HK)",
  "settings": [
    { "type": "text", "id": "fallback_image_url", "label": "Fallback Image URL" },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "Title" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Expert Advice" },
    { "type": "url", "id": "btn_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Vellano Editorial (HK)" }
  ]
}
{% endschema %}