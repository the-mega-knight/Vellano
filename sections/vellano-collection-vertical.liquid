{%- style -%}
  .vellano-vertical-collection {
    background: #F8F6F3;
    color: #111;
    padding: 80px 0;
    overflow: hidden;
  }
  .vellano-vertical-header {
    text-align: center;
    padding: 0 5%;
    margin-bottom: 80px;
  }
  .vellano-vertical-title {
    font-family: var(--font-heading-family);
    font-size: 48px;
    font-weight: 400;
    margin-bottom: 16px;
    color: #111;
  }
  .vellano-vertical-desc {
    font-size: 16px;
    color: #555;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .vellano-vertical-product {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: 120px;
    content-visibility: auto;
    contain-intrinsic-size: 0 800px;
  }
  @media (min-width: 900px) {
    .vellano-vertical-product {
      flex-direction: row;
      align-items: center;
    }
    .vellano-vertical-product.reverse {
      flex-direction: row-reverse;
    }
  }

  .vellano-vp-image-col,
  .vellano-vp-text-col {
    flex: 1;
    width: 100%;
  }

  .vellano-vp-image-wrap {
    width: 100%;
    height: 100%;
    min-height: 500px;
    position: relative;
    overflow: hidden;
  }
  .vellano-vp-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .vellano-vp-text-col {
    padding: 60px 5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .vellano-vp-text-col {
      padding: 80px 8%;
    }
  }

  .vellano-vp-title {
    font-family: var(--font-heading-family);
    font-size: 36px;
    line-height: 1.2;
    margin-bottom: 20px;
    color: #111;
  }
  .vellano-vp-price {
    font-size: 20px;
    font-weight: 600;
    color: #B8A07A;
    margin-bottom: 24px;
  }
  .vellano-vp-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #555;
    margin-bottom: 40px;
  }
  .vellano-vp-btn {
    display: inline-block;
    padding: 14px 32px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 12px;
    border-radius: 30px;
    transition: background 0.3s, transform 0.3s;
    align-self: flex-start;
  }
  .vellano-vp-btn:hover {
    background: #333;
    transform: scale(1.02);
  }

  /* Intersection Observer Animation Classes */
  .vellano-fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .vellano-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
{%- endstyle -%}

<div class="vellano-vertical-collection">
  <div class="vellano-vertical-header vellano-fade-up">
    <h1 class="vellano-vertical-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="vellano-vertical-desc">{{ collection.description }}</div>
    {% endif %}
  </div>

  <div class="vellano-vertical-products">
    {% for product in collection.products %}
      {% assign mod = forloop.index | modulo: 2 %}
      <div class="vellano-vertical-product {% if mod == 0 %}reverse{% endif %} vellano-fade-up">
        <div class="vellano-vp-image-col">
          <div class="vellano-vp-image-wrap">
            {% if product.featured_image %}
              {% if forloop.first %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'vellano-vp-image', fetchpriority: 'high', widths: '600, 900, 1200' }}
              {% else %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'vellano-vp-image', loading: 'lazy', widths: '600, 900, 1200' }}
              {% endif %}
            {% else %}
              <div style="width: 100%; height: 100%; min-height: 500px; background: rgba(var(--color-foreground), 0.04);"></div>
            {% endif %}
          </div>
        </div>
        <div class="vellano-vp-text-col">
          <h2 class="vellano-vp-title">{{ product.title }}</h2>
          <div class="vellano-vp-price">{{ product.price | money }}</div>
          <div class="vellano-vp-desc">
            {{ product.description | strip_html | truncatewords: 50 | default: 'Enhance your daily routine with our premium hard water defense hardware.' }}
          </div>
          <a href="{{ product.url }}" class="vellano-vp-btn">Explore Product</a>
        </div>
      </div>
    {% else %}
      <div class="vellano-vertical-product vellano-fade-up" style="text-align: center; padding: 100px 5%; display: block;">
        <p style="color: #888;">No products found in this collection.</p>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const fadeElements = document.querySelectorAll('.vellano-fade-up');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };
    
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    
    fadeElements.forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Collection Vertical",
  "settings": [],
  "presets": [
    {
      "name": "Collection Vertical Narrative"
    }
  ]
}
{% endschema %}
