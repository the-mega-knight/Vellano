{%- style -%}
  .vellano-usp-sec {
    background: #111;
    color: #F8F6F3;
    padding: 32px 5%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 80px;
    flex-wrap: wrap;
  }
  .vellano-usp-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .vellano-usp-icon svg {
    width: 24px;
    height: 24px;
    stroke: #B8A07A;
    fill: none;
    stroke-width: 1.5;
  }
  .vellano-usp-text {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .vellano-usp-sec { gap: 32px; flex-direction: column; text-align: left; align-items: flex-start; padding: 40px 10%; }
  }
{%- endstyle -%}

<div class="vellano-usp-sec">
  <div class="vellano-usp-item">
    <div class="vellano-usp-icon">
      <svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"></path></svg>
    </div>
    <div class="vellano-usp-text">Free Shipping On Orders Over $50</div>
  </div>
  
  <div class="vellano-usp-item">
    <div class="vellano-usp-icon">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
    </div>
    <div class="vellano-usp-text">30-Day Results Guarantee</div>
  </div>

  <div class="vellano-usp-item">
    <div class="vellano-usp-icon">
      <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
    </div>
    <div class="vellano-usp-text">Easy 2-Minute Install</div>
  </div>
</div>

