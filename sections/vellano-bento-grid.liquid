{%- style -%}
  .hk-bento-grid {
    border-radius: 16px;
    overflow: hidden;
    padding: 20px;
    background: #F8F6F3;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(300px, auto);
    gap: 2px;
    background-color: #B6B0AA; /* Borders created by grid gap */
  }
  .hk-bento-item {
    background: #F8F6F3;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
    text-decoration: none;
    overflow: hidden;
  }
  .hk-bento-item.large {
    grid-column: span 2;
    flex-direction: row;
    align-items: center;
  }
  .hk-bento-text {
    z-index: 2;
    max-width: 50%;
  }
  .hk-bento-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 42px;
    color: #111111;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .hk-bento-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    color: #111111;
    margin-bottom: 30px;
  }
  .hk-bento-btn {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid #111111;
    color: #111111;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
    font-family: 'Jost', sans-serif;
    border-radius: 30px;
  }
  .hk-bento-item:hover .hk-bento-btn {
    background: #111111;
    color: #F8F6F3;
  }
  .hk-bento-img {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 90%;
    object-fit: contain;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vellano-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 30%;
    background-image: url("{{ 'vellano_brandkit.png' | asset_url }}");
    background-size: 100% 200%; /* Top half is wordmark */
    background-position: top center; 
    filter: invert(1);
    mix-blend-mode: screen;
    opacity: 0.85;
    pointer-events: none;
    z-index: 5;
  }
  .hk-bento-item:hover .hk-bento-img {
    transform: scale(1.05);
  }
  .hk-bento-item.large .hk-bento-img {
    position: relative;
    height: auto;
    width: 45%;
  }
  @media (max-width: 900px) {
    .hk-bento-grid { grid-template-columns: 1fr; }
    .hk-bento-item.large { grid-column: span 1; flex-direction: column; }
    .hk-bento-text { max-width: 100%; }
    .hk-bento-item.large .hk-bento-img { width: 100%; margin-top: 30px; }
  }
  @media (max-width: 768px) {
    .hk-bento-title { font-size: 32px !important; }
  }
{%- endstyle -%}

<div class="hk-bento-container" style="max-width: 1400px; margin: 40px auto; padding: 0 20px;">
<div class="hk-bento-grid" id="system">
  <!-- Main Banner -->
  <a href="/products/vellano-filtered-showerhead-starter-kit" class="hk-bento-item large">
    <div class="hk-bento-text">
      <h2 class="hk-bento-title">Purify your daily ritual.</h2>
      <p class="hk-bento-subtitle">The Vellano system guarantees a noticeable difference in 14 days by filtering hard water.</p>
      <span class="hk-bento-btn">Shop The System</span>
    </div>
    <img src="{{ 'vellano_water_flow.png' | asset_url }}" class="hk-bento-img" alt="The Handheld System" style="width: 50%; height: auto; object-fit: cover; border-radius: 8px;">
  </a>
  
  <!-- Sub Items -->
  <a href="/collections/all" class="hk-bento-item">
    <div class="hk-bento-text">
      <h2 class="hk-bento-title" style="font-size: 28px;">Hard water protection</h2>
      <p class="hk-bento-subtitle">Upgrade your shower</p>
    </div>
    <span class="hk-bento-btn" style="align-self: flex-start; margin-top: auto; z-index: 2;">Shop Best Sellers</span>
    <img src="{{ 'vellano_product_hero.png' | asset_url }}" class="hk-bento-img" alt="Wall Filter" style="position: absolute; right: 0; bottom: 0; height: 100%; width: 50%; object-fit: cover;">
  </a>
  
  <a href="/?view=science" class="hk-bento-item" style="background-color: #D9D4CE;">
    <div class="hk-bento-text">
      <h2 class="hk-bento-title" style="font-size: 28px;">The Science</h2>
      <p class="hk-bento-subtitle">How it works</p>
    </div>
    <span class="hk-bento-btn" style="align-self: flex-start; margin-top: auto; z-index: 2;">Learn More</span>
    <img src="{{ 'vellano_refill_cartridge.png' | asset_url }}" class="hk-bento-img" alt="Filter Refills" style="position: absolute; right: 20px; bottom: 20px; height: 70%; width: auto; object-fit: contain;">
  </a>
</div>
</div>

{% schema %}
{
  "name": "Vellano Bento Grid",
  "presets": [{ "name": "Vellano Bento Grid" }]
}
{% endschema %}
