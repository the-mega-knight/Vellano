{%- style -%}
  .hk-bento-grid {
    border-radius: 16px;
    overflow: hidden;
    padding: 20px;
    background: #F8F6F3;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(300px, auto);
    gap: 2px;
    background-color: #B6B0AA; /* Borders created by grid gap */
  }
  .hk-bento-item {
    background: #F8F6F3;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
    text-decoration: none;
    overflow: hidden;
  }
  .hk-bento-item.large {
    grid-column: span 2;
    flex-direction: row;
    align-items: center;
  }
  .hk-bento-text {
    z-index: 2;
    max-width: 50%;
  }
  .hk-bento-title {
    font-family: var(--font-heading-family);
    font-size: 42px;
    color: #111111;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .hk-bento-subtitle {
    font-size: 16px;
    color: #111111;
    margin-bottom: 30px;
  }
  .hk-bento-btn {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid #111111;
    color: #111111;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
    border-radius: 30px;
  }
  .hk-bento-item:hover .hk-bento-btn {
    background: #111111;
    color: #F8F6F3;
  }
  .hk-bento-img {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 90%;
    object-fit: contain;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vellano-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 30%;
    /* background-image: url("{{ 'vellano_brandkit.png' | asset_url }}"); removed */
    background-size: 100% 200%; /* Top half is wordmark */
    background-position: top center; 
    filter: invert(1);
    mix-blend-mode: screen;
    opacity: 0.85;
    pointer-events: none;
    z-index: 5;
  }
  .hk-bento-item:hover .hk-bento-img {
    transform: scale(1.05);
  }
  .hk-bento-item.large .hk-bento-img {
    position: relative;
    height: auto;
    width: 45%;
  }
  @media (max-width: 900px) {
    .hk-bento-grid { grid-template-columns: 1fr; }
    .hk-bento-item.large { grid-column: span 1; flex-direction: column; }
    .hk-bento-text { max-width: 100%; }
    .hk-bento-item.large .hk-bento-img { width: 100%; margin-top: 30px; }
  }
  @media (max-width: 768px) {
    .hk-bento-title { font-size: 32px !important; }
  }
  {% if section.settings.watermark_image != blank %}
  .vellano-watermark {
    background-image: url("{{ section.settings.watermark_image | image_url: width: 800 }}");
  }
  {% endif %}
{%- endstyle -%}

<div class="hk-bento-container" style="max-width: 1400px; margin: 40px auto; padding: 0 20px;">
  <div class="hk-bento-grid" id="system">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="hk-bento-item {% if block.settings.is_large %}large{% endif %}" style="background-color: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
        <div class="hk-bento-text">
          <h2 class="hk-bento-title" {% unless block.settings.is_large %}style="font-size: 28px;"{% endunless %}>{{ block.settings.title }}</h2>
          <p class="hk-bento-subtitle">{{ block.settings.subtitle }}</p>
          {% if block.settings.btn_label != blank %}
            <span class="hk-bento-btn" {% unless block.settings.is_large %}style="align-self: flex-start; margin-top: auto; z-index: 2;"{% endunless %}>{{ block.settings.btn_label }}</span>
          {% endif %}
        </div>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 800 | image_tag: class: 'hk-bento-img', loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'hk-bento-img' }}
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bento Grid (Dynamic)",
  "settings": [
    {
      "type": "image_picker",
      "id": "watermark_image",
      "label": "Watermark Background Image"
    }
  ],
  "blocks": [
    {
      "type": "bento_item",
      "name": "Bento Item",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_large",
          "label": "Make this item large (span 2 columns)",
          "default": false
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#F8F6F3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "New Feature"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Learn more about this feature."
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Grid (Dynamic)",
      "category": "Custom",
      "blocks": [
        {
          "type": "bento_item",
          "settings": {
            "is_large": true,
            "title": "Purify your daily ritual.",
            "subtitle": "The Vellano system guarantees a noticeable difference in 14 days by filtering hard water.",
            "btn_label": "Shop The Collection"
          }
        },
        {
          "type": "bento_item",
          "settings": {
            "is_large": false,
            "title": "Hard water protection",
            "subtitle": "Upgrade your shower",
            "btn_label": "Shop Best Sellers"
          }
        },
        {
          "type": "bento_item",
          "settings": {
            "is_large": false,
            "bg_color": "#D9D4CE",
            "title": "The Science",
            "subtitle": "How it works",
            "btn_label": "Learn More"
          }
        }
      ]
    }
  ]
}
{% endschema %}
